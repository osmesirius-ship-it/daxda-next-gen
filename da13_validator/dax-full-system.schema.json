{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dax.local/schemas/dax-full-system.schema.json",
  "title": "DAX Full-System Governed Output Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "input",
    "execution",
    "layers",
    "stability",
    "dax_decision",
    "governed_output",
    "audit",
    "telemetry",
    "recursion"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "timestamp",
        "mode",
        "max_iterations",
        "current_iteration"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^2\\.0(\\.[0-9]+)?$"
        },
        "run_id": {
          "type": "string",
          "minLength": 8
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "type": "string",
          "enum": [
            "governed",
            "diagnostic"
          ]
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "current_iteration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "trace_id": {
          "type": "string"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "normalized_intent",
        "constraints"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "normalized_intent": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "context": {
          "type": "object"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "model_provider",
        "temperature",
        "timeout_ms",
        "retry_policy"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "dax-core"
          ]
        },
        "model_provider": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000
        },
        "retry_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_retries",
            "backoff_ms"
          ],
          "properties": {
            "max_retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "backoff_ms": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/layerResult"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-15"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-14"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-13"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-12"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-11"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-10"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-9"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-8"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-7"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-6"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-5"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-4"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-3"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-2"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-1"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "DA-X"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      ]
    },
    "stability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula",
        "weights",
        "components",
        "score",
        "threshold"
      ],
      "properties": {
        "formula": {
          "type": "string",
          "const": "S=wL*L+wA*A+wP*P+wF*F+wT*T"
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wL",
            "wA",
            "wP",
            "wF",
            "wT",
            "sum"
          ],
          "properties": {
            "wL": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "wA": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "wP": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "wF": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "wT": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sum": {
              "type": "number",
              "const": 1
            }
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "L",
            "A",
            "P",
            "F",
            "T"
          ],
          "properties": {
            "L": {
              "$ref": "#/$defs/stabilityComponent"
            },
            "A": {
              "$ref": "#/$defs/stabilityComponent"
            },
            "P": {
              "$ref": "#/$defs/stabilityComponent"
            },
            "F": {
              "$ref": "#/$defs/stabilityComponent"
            },
            "T": {
              "$ref": "#/$defs/stabilityComponent"
            }
          }
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "threshold": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1
        }
      }
    },
    "dax_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_codes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ACCEPT",
            "RECURSE",
            "HALT"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reasonCode"
          },
          "minItems": 1
        },
        "human_checkpoint_required": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "governed_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "confidence",
        "uncertainty",
        "recommendations"
      ],
      "properties": {
        "result": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trail_id",
        "records",
        "redaction_applied"
      ],
      "properties": {
        "trail_id": {
          "type": "string"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/auditRecord"
          },
          "minItems": 1
        },
        "redaction_applied": {
          "type": "boolean"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_latency_ms",
        "layer_latency_ms",
        "retry_count",
        "anomaly_count",
        "halt_count"
      ],
      "properties": {
        "total_latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "layer_latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "DA-15",
            "DA-14",
            "DA-13",
            "DA-12",
            "DA-11",
            "DA-10",
            "DA-9",
            "DA-8",
            "DA-7",
            "DA-6",
            "DA-5",
            "DA-4",
            "DA-3",
            "DA-2",
            "DA-1",
            "DA-X"
          ],
          "properties": {
            "DA-15": {
              "type": "integer",
              "minimum": 0
            },
            "DA-14": {
              "type": "integer",
              "minimum": 0
            },
            "DA-13": {
              "type": "integer",
              "minimum": 0
            },
            "DA-12": {
              "type": "integer",
              "minimum": 0
            },
            "DA-11": {
              "type": "integer",
              "minimum": 0
            },
            "DA-10": {
              "type": "integer",
              "minimum": 0
            },
            "DA-9": {
              "type": "integer",
              "minimum": 0
            },
            "DA-8": {
              "type": "integer",
              "minimum": 0
            },
            "DA-7": {
              "type": "integer",
              "minimum": 0
            },
            "DA-6": {
              "type": "integer",
              "minimum": 0
            },
            "DA-5": {
              "type": "integer",
              "minimum": 0
            },
            "DA-4": {
              "type": "integer",
              "minimum": 0
            },
            "DA-3": {
              "type": "integer",
              "minimum": 0
            },
            "DA-2": {
              "type": "integer",
              "minimum": 0
            },
            "DA-1": {
              "type": "integer",
              "minimum": 0
            },
            "DA-X": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "anomaly_count": {
          "type": "integer",
          "minimum": 0
        },
        "halt_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "recursion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "max_iterations",
        "next_action"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "next_action": {
          "type": "string",
          "enum": [
            "REENTER",
            "STOP"
          ]
        },
        "mutation_contract": {
          "$ref": "#/$defs/mutationContract"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dax_decision": {
            "properties": {
              "status": {
                "const": "RECURSE"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "recursion": {
            "required": [
              "mutation_contract"
            ],
            "properties": {
              "next_action": {
                "const": "REENTER"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dax_decision": {
            "properties": {
              "status": {
                "const": "HALT"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "recursion": {
            "properties": {
              "next_action": {
                "const": "STOP"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "reasonCode": {
      "type": "string",
      "enum": [
        "VAL-001",
        "VAL-002",
        "VAL-003",
        "VAL-004",
        "VAL-005",
        "VAL-006",
        "VAL-007",
        "VAL-008",
        "VAL-009",
        "VAL-010"
      ]
    },
    "stabilityComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "derivation"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "derivation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text",
        "verifiable",
        "evidence_refs"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "verifiable": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "layerMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "latency_ms",
        "tokens_used",
        "contradictions",
        "claims_count",
        "unsupported_claims"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_used": {
          "type": "integer",
          "minimum": 0
        },
        "contradictions": {
          "type": "integer",
          "minimum": 0
        },
        "claims_count": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported_claims": {
          "type": "integer",
          "minimum": 0
        },
        "sim_passed": {
          "type": "integer",
          "minimum": 0
        },
        "sim_total": {
          "type": "integer",
          "minimum": 0
        },
        "failed_tests": {
          "type": "integer",
          "minimum": 0
        },
        "total_tests": {
          "type": "integer",
          "minimum": 0
        },
        "verifiable_claims": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "layerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "input_text",
        "output_text",
        "claims",
        "metrics"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "DA-15",
            "DA-14",
            "DA-13",
            "DA-12",
            "DA-11",
            "DA-10",
            "DA-9",
            "DA-8",
            "DA-7",
            "DA-6",
            "DA-5",
            "DA-4",
            "DA-3",
            "DA-2",
            "DA-1",
            "DA-X"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "input_text": {
          "type": "string"
        },
        "output_text": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "metrics": {
          "$ref": "#/$defs/layerMetrics"
        }
      }
    },
    "auditRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_id",
        "input_hash",
        "output_hash",
        "timestamp",
        "decision"
      ],
      "properties": {
        "layer_id": {
          "type": "string",
          "enum": [
            "DA-15",
            "DA-14",
            "DA-13",
            "DA-12",
            "DA-11",
            "DA-10",
            "DA-9",
            "DA-8",
            "DA-7",
            "DA-6",
            "DA-5",
            "DA-4",
            "DA-3",
            "DA-2",
            "DA-1",
            "DA-X"
          ]
        },
        "input_hash": {
          "type": "string",
          "minLength": 8
        },
        "output_hash": {
          "type": "string",
          "minLength": 8
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mutationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_layers",
        "adjusted_weights",
        "constraints_added",
        "critiques_injected"
      ],
      "properties": {
        "target_layers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "DA-14",
              "DA-10",
              "DA-9",
              "DA-8",
              "DA-6",
              "DA-3",
              "DA-2"
            ]
          }
        },
        "adjusted_weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wL",
            "wA",
            "wP",
            "wF",
            "wT"
          ],
          "properties": {
            "wL": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "wA": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "wP": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "wF": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "wT": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "constraints_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "critiques_injected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
